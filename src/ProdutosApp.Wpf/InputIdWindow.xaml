<Window x:Class="ProdutosApp.Wpf.InputIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informe o ID"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="White">
    <StackPanel Margin="22" Width="300">
        <TextBlock x:Name="txtMensagem" Text="Informe o ID do produto:" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10"/>
        <TextBox x:Name="txtValor"/>
        <TextBlock x:Name="txtErro" Foreground="#DC2626" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" IsCancel="True"/>
            <Button Content="OK" Style="{StaticResource BotaoPrimario}" IsDefault="True" Margin="8,0,0,0" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
