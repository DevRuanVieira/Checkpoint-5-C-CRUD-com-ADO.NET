<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interface gráfica (WPF). Não contém SQL: todo acesso ao banco passa pelo IProdutoRepository. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProdutosApp.Wpf</RootNamespace>
    <AssemblyName>ProdutosApp</AssemblyName>
    <!-- Permite restaurar/compilar a solução também fora do Windows (a execução continua exigindo Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProdutosApp.Core\ProdutosApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configurações (connection string e caminho do log) -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- O mesmo script entregue na pasta /database é copiado para junto do executável
         e executado na inicialização (CREATE TABLE IF NOT EXISTS). -->
    <None Include="..\..\database\criar_tabela.sql" Link="database\criar_tabela.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
